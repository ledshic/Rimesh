{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rimesh",
  "version": "0.1.0",
  "identifier": "dev.rimesh.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rimesh",
        "width": 780,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/rimesh-service"
    ]
  },
  "plugins": {
    "shell": {
      "open": true,
      "sidecar": true,
      "execute": true
    }
  }
}
